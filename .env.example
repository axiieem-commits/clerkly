PORT=3000

# Your deployed Vercel address. Use http://localhost:3000 while testing locally.
APP_URL=http://localhost:3000

# Supabase Dashboard > Connect or Settings > API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional: enables flexible AI answers. Without it, the guided assistant still works.
GEMINI_API_KEY=your-gemini-api-key
